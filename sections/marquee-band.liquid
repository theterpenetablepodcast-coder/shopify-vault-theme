<div class="marquee-band" aria-hidden="true">
  <div class="marquee-band__track" id="marquee-track">
    {%- assign marquee_items = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.text != blank -%}
        {%- assign marquee_items = marquee_items | append: block.settings.text | append: '|||' -%}
      {%- endif -%}
    {%- else -%}
      {%- assign marquee_items = 'Free the plant|||Drop the stigma|||Community over clout|||Rooted in fire|||Australian owned|||Grown not bought|||' -%}
    {%- endfor -%}

    {%- assign item_arr = marquee_items | split: '|||' -%}
    {%- comment -%} Render 3 passes so shuffle JS has enough width to loop {%- endcomment -%}
    {%- for pass in (1..3) -%}
      {%- for item in item_arr -%}
        {%- if item != blank -%}
          <span class="marquee-band__item">
            <span class="marquee-band__dot"></span>
            {{ item | strip | upcase }}
          </span>
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Band",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "item",
      "name": "Marquee item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Band",
      "blocks": [
        { "type": "item", "settings": { "text": "Free the plant" } },
        { "type": "item", "settings": { "text": "Drop the stigma" } },
        { "type": "item", "settings": { "text": "Community over clout" } },
        { "type": "item", "settings": { "text": "Rooted in fire" } },
        { "type": "item", "settings": { "text": "Australian Owned" } },
        { "type": "item", "settings": { "text": "Made to order" } }
      ]
    }
  ]
}
{% endschema %}
