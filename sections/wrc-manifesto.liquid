<section class="wrc-manifesto">
  <div class="page-width">

    <div class="wrc-manifesto__intro" data-reveal>
      <p class="section-eyebrow" style="justify-content:flex-start;">
        {{ section.settings.eyebrow | default: 'What we stand for' }}
      </p>
      <h2 class="wrc-manifesto__heading">
        {{ section.settings.heading | default: 'We were never just selling shirts.' }}
      </h2>
      {%- if section.settings.body != blank -%}
        <p class="wrc-manifesto__body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="wrc-pillars">
        {%- for block in section.blocks -%}
          <div class="wrc-pillar" {{ block.shopify_attributes }} data-reveal>
            <span class="wrc-pillar__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="wrc-pillar__title">{{ block.settings.title }}</h3>
            <p class="wrc-pillar__text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .wrc-manifesto {
    padding: 100px 0;
    background: var(--clr-dark);
    border-top: 1px solid var(--clr-border);
    border-bottom: 1px solid var(--clr-border);
    position: relative;
    overflow: hidden;
  }

  .wrc-manifesto::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 50% 60% at 12% 0%, rgba(var(--clr-accent-rgb), 0.07), transparent 70%);
    pointer-events: none;
  }

  .wrc-manifesto__intro {
    position: relative;
    max-width: 780px;
  }

  .wrc-manifesto__heading {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.6vw, 3.4rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--clr-white);
    margin: 0;
  }

  .wrc-manifesto__body {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--clr-silver);
    margin-top: 22px;
    max-width: 660px;
  }

  .wrc-pillars {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 64px;
  }

  .wrc-pillar {
    background: var(--clr-panel);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: var(--radius-lg);
    padding: 34px 30px 38px;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .wrc-pillar:hover { border-color: rgba(var(--clr-accent-rgb), 0.28); transform: translateY(-3px); }

  .wrc-pillar__num {
    display: block;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--clr-leaf);
    margin-bottom: 18px;
  }

  .wrc-pillar__title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--clr-white);
    margin: 0 0 12px;
    line-height: 1.15;
  }

  .wrc-pillar__text {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--clr-silver-dim);
    margin: 0;
  }

  @media (max-width: 900px) {
    .wrc-manifesto  { padding: 72px 0; }
    .wrc-pillars    { grid-template-columns: 1fr; margin-top: 48px; }
  }
</style>

{% schema %}
{
  "name": "Manifesto",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "What we stand for"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We were never just selling shirts."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body copy"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text",     "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text",  "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Manifesto",
      "blocks": [
        { "type": "pillar" },
        { "type": "pillar" },
        { "type": "pillar" }
      ]
    }
  ]
}
{% endschema %}
