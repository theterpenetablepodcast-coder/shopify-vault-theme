<section class="wrc-hero" style="{% if section.settings.bg_image != blank %}--hero-bg: url('{{ section.settings.bg_image | img_url: '2000x' }}'){% endif %}">

  {%- if section.settings.bg_image != blank -%}
    <style>
      .wrc-hero { background-image: var(--hero-bg); background-size: cover; background-position: center; }
      .wrc-hero::after { content:''; position:absolute; inset:0; background:rgba(8,8,7,0.78); z-index:1; }
    </style>
  {%- endif -%}

  <!-- Root system watermark -->
  <div class="wrc-hero__roots" aria-hidden="true">
    <svg viewBox="0 0 800 500" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMax meet">
      <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" fill="none">
        <!-- Taproot -->
        <path d="M400 0 V300"/>
        <path d="M400 300 C400 360 398 420 396 480"/>
        <!-- Primary laterals -->
        <path d="M400 120 C340 160 300 210 268 286"/>
        <path d="M400 120 C460 160 500 210 532 286"/>
        <path d="M400 190 C352 232 322 282 300 350"/>
        <path d="M400 190 C448 232 478 282 500 350"/>
        <path d="M400 262 C366 300 344 344 330 400"/>
        <path d="M400 262 C434 300 456 344 470 400"/>
        <!-- Secondary tendrils -->
        <path d="M330 214 C300 236 280 262 268 296"/>
        <path d="M470 214 C500 236 520 262 532 296"/>
        <path d="M352 300 C330 326 316 356 308 392"/>
        <path d="M448 300 C470 326 484 356 492 392"/>
        <path d="M372 352 C356 382 348 414 344 452"/>
        <path d="M428 352 C444 382 452 414 456 452"/>
        <path d="M290 330 C272 356 262 386 258 420"/>
        <path d="M510 330 C528 356 538 386 542 420"/>
      </g>
      <g fill="currentColor">
        <circle cx="268" cy="296" r="2.5"/>
        <circle cx="532" cy="296" r="2.5"/>
        <circle cx="308" cy="392" r="2.5"/>
        <circle cx="492" cy="392" r="2.5"/>
        <circle cx="344" cy="452" r="2.5"/>
        <circle cx="456" cy="452" r="2.5"/>
        <circle cx="258" cy="420" r="2.5"/>
        <circle cx="542" cy="420" r="2.5"/>
        <circle cx="396" cy="480" r="3"/>
      </g>
    </svg>
  </div>

  <div class="wrc-hero__content" data-reveal>

    {%- if section.settings.hero_image != blank -%}
      <div class="wrc-hero__art">
        <img src="{{ section.settings.hero_image | img_url: '1400x' }}"
             alt="{{ shop.name | escape }}"
             width="{{ section.settings.hero_image.width }}"
             height="{{ section.settings.hero_image.height }}"
             loading="eager"
             fetchpriority="high">
      </div>
    {%- endif -%}

    <p class="hero-eyebrow">
      <span class="hero-eyebrow__rule" aria-hidden="true"></span>
      {{ section.settings.eyebrow | default: 'Australian Owned — Shipped Locally' }}
      <span class="hero-eyebrow__rule" aria-hidden="true"></span>
    </p>

    {%- comment -%}
      When the logo art is shown it already carries the wordmark, so the H1
      is kept for SEO and screen readers but hidden visually.
    {%- endcomment -%}
    <h1 class="hero-title{% if section.settings.hero_image != blank %} sr-only{% endif %}">
      {{ section.settings.title | default: 'The Wild' }}
      <span class="hero-title__accent">{{ section.settings.title_accent | default: 'Vault' }}</span>
    </h1>

    {%- if section.settings.subtitle != blank -%}
      <p class="hero-subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="hero-cta">
      {%- if section.settings.btn_primary_label != blank -%}
        <a href="{{ section.settings.btn_primary_url | default: routes.all_products_collection_url }}"
           class="btn btn--primary">
          {{ section.settings.btn_primary_label }}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
      {%- endif -%}

      {%- if section.settings.btn_secondary_label != blank -%}
        <a href="{{ section.settings.btn_secondary_url | default: routes.collections_url }}"
           class="btn btn--outline">
          {{ section.settings.btn_secondary_label }}
        </a>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero logo / artwork",
      "info": "Shown large and centred. Use a transparent PNG. When set, the text heading is hidden but kept for SEO."
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image (optional)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Australian Owned — Shipped Locally"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Wild"
    },
    {
      "type": "text",
      "id": "title_accent",
      "label": "Heading — highlighted word",
      "default": "Vault"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Clothing, accessories and grow gear. Shipped from Victoria."
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary button text",
      "default": "Shop the range"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary button URL"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Secondary button text",
      "default": "Browse collections"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Secondary button URL"
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
