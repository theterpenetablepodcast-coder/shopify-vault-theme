<section class="section vault-cat-section" id="cat-grid-{{ section.id }}">
  <div class="page-width">

    <!-- Header -->
    <div class="section-header" data-reveal>
      <p class="section-eyebrow">{{ section.settings.eyebrow | default: 'VAULT DIRECTORY' }}</p>
      <h2 class="section-title" data-scramble-scroll>
        {{ section.settings.title | default: 'SELECT YOUR CLEARANCE' }}
      </h2>
      {%- if section.settings.description != blank -%}
        <p class="section-desc">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <!-- Category tiles -->
    <div class="vault-cat-grid" style="margin-top: 48px;">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        {%- if collection == blank -%}{%- continue -%}{%- endif -%}

        {%- comment -%} Resolve tile image: block override → known asset → collection image → first product {%- endcomment -%}
        {%- assign tile_img = '' -%}
        {%- if block.settings.image != blank -%}
          {%- assign tile_img = block.settings.image | img_url: '800x600', crop: 'center' -%}
        {%- elsif collection.handle contains 'genetic' -%}
          {%- assign tile_img = 'collection-genetics.png' | asset_url -%}
        {%- elsif collection.handle contains 'cloth' or collection.handle contains 'merch' -%}
          {%- assign tile_img = 'collection-clothing.png' | asset_url -%}
        {%- elsif collection.image -%}
          {%- assign tile_img = collection.image | img_url: '800x600', crop: 'center' -%}
        {%- elsif collection.products.first.featured_image -%}
          {%- assign tile_img = collection.products.first.featured_image | img_url: '800x600', crop: 'center' -%}
        {%- endif -%}

        <a href="{{ collection.url }}" class="collection-card" aria-label="{{ block.settings.label | default: collection.title }}" {% if forloop.index > 1 %}data-reveal{% endif %}>

          <div class="collection-card__img">
            {%- if tile_img != '' -%}
              <img src="{{ tile_img }}"
                   alt="{{ block.settings.label | default: collection.title | escape }}"
                   width="800" height="600"
                   loading="lazy">
            {%- else -%}
              <div class="collection-card__no-img" aria-hidden="true">
                <svg viewBox="0 0 120 120" width="80" height="80" fill="none">
                  <circle cx="60" cy="60" r="54" stroke="#1e1e1e" stroke-width="3"/>
                  <circle cx="60" cy="60" r="40" stroke="#00ff41" stroke-width="1.5" stroke-dasharray="5 4" opacity="0.5"/>
                  <circle cx="60" cy="60" r="14" fill="#0d0d0d" stroke="#c8cdd4" stroke-width="2"/>
                  <circle cx="60" cy="60" r="6"  fill="#111" stroke="#00ff41" stroke-width="1.5"/>
                  <line x1="60" y1="8"  x2="60" y2="20" stroke="#00ff41" stroke-width="2" stroke-linecap="round"/>
                  <line x1="60" y1="100" x2="60" y2="112" stroke="#7a8090" stroke-width="1.5" stroke-linecap="round"/>
                  <line x1="8"  y1="60" x2="20" y2="60" stroke="#7a8090" stroke-width="1.5" stroke-linecap="round"/>
                  <line x1="100" y1="60" x2="112" y2="60" stroke="#7a8090" stroke-width="1.5" stroke-linecap="round"/>
                  <rect x="74" y="56" width="20" height="8" rx="4" fill="#c8cdd4"/>
                </svg>
              </div>
            {%- endif -%}

            <div class="collection-card__overlay">
              <span class="collection-card__cta">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                ACCESS VAULT
              </span>
            </div>

            <div class="collection-card__count">
              {{ collection.products_count }}
              <span style="font-size:0.5rem;letter-spacing:0.15em;margin-left:2px;">ITEMS</span>
            </div>
          </div>

          <div class="collection-card__body">
            <div>
              <p class="collection-card__eyebrow">CATEGORY //</p>
              <h3 class="collection-card__title">{{ block.settings.label | default: collection.title }}</h3>
              {%- if block.settings.subtext != blank -%}
                <p class="collection-card__desc">{{ block.settings.subtext }}</p>
              {%- endif -%}
            </div>
            <div class="collection-card__arrow" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </div>
          </div>

        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

{% render 'collection-card-styles' %}

<style>
  .vault-cat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }
  @media (max-width: 900px) {
    .vault-cat-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .vault-cat-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "VAULT DIRECTORY"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "SELECT YOUR CLEARANCE"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label override",
          "info": "Leave blank to use the collection title"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile image override"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Collection Grid",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
