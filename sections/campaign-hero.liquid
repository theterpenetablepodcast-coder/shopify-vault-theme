{%- comment -%}
  Campaign hero: a full-bleed lifestyle photo with the line and buttons over
  its lower edge. Phones show the first image at its own portrait shape;
  from tablet width up, a second image (if set) sits beside it.
{%- endcomment -%}
{%- assign img_1 = section.settings.image -%}
{%- assign img_2 = section.settings.image_2 -%}

<section class="campaign-hero{% if img_2 != blank %} campaign-hero--split{% endif %}">

  {%- if section.settings.page_heading -%}
    <h1 class="sr-only">{{ shop.name }}</h1>
  {%- endif -%}

  <div class="campaign-hero__media">
    {%- if img_1 != blank -%}
      <div class="campaign-hero__frame">
        <img src="{{ img_1 | image_url: width: 1200 }}"
             srcset="{{ img_1 | image_url: width: 600 }} 600w, {{ img_1 | image_url: width: 900 }} 900w, {{ img_1 | image_url: width: 1200 }} 1200w, {{ img_1 | image_url: width: 1664 }} 1664w"
             sizes="{% if img_2 != blank %}(min-width: 769px) 50vw, {% endif %}100vw"
             alt="{{ section.settings.image_alt | default: img_1.alt | escape }}"
             width="{{ img_1.width }}" height="{{ img_1.height }}"
             loading="eager" fetchpriority="high">
      </div>
    {%- endif -%}
    {%- if img_2 != blank -%}
      {%- comment -%} lazy: phones never display it, so they never download it. {%- endcomment -%}
      <div class="campaign-hero__frame campaign-hero__frame--2">
        <img src="{{ img_2 | image_url: width: 1200 }}"
             srcset="{{ img_2 | image_url: width: 600 }} 600w, {{ img_2 | image_url: width: 900 }} 900w, {{ img_2 | image_url: width: 1200 }} 1200w"
             sizes="50vw"
             alt="{{ section.settings.image_2_alt | default: img_2.alt | escape }}"
             width="{{ img_2.width }}" height="{{ img_2.height }}"
             loading="lazy">
      </div>
    {%- endif -%}
  </div>

  <div class="campaign-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="campaign-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="campaign-hero__title">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="campaign-hero__sub">{{ section.settings.subtitle }}</p>
    {%- endif -%}
    {%- if section.settings.btn_1_label != blank or section.settings.btn_2_label != blank -%}
      <div class="campaign-hero__ctas">
        {%- if section.settings.btn_1_label != blank -%}
          <a href="{{ section.settings.btn_1_url | default: routes.all_products_collection_url }}" class="btn btn--primary">{{ section.settings.btn_1_label }}</a>
        {%- endif -%}
        {%- if section.settings.btn_2_label != blank -%}
          <a href="{{ section.settings.btn_2_url | default: routes.collections_url }}" class="btn btn--outline campaign-hero__btn-alt">{{ section.settings.btn_2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .campaign-hero {
    position: relative;
    overflow: hidden;
    background: #000;
  }
  .campaign-hero__media { display: grid; grid-template-columns: 1fr; }
  .campaign-hero__frame { aspect-ratio: 4 / 5; overflow: hidden; }
  .campaign-hero__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .campaign-hero__frame--2 { display: none; }

  /* Darkens the lower part so the line and buttons read over any photo. */
  .campaign-hero::after {
    content: '';
    position: absolute;
    inset: 38% 0 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.55) 45%, rgba(0, 0, 0, 0.88) 100%);
    pointer-events: none;
  }

  .campaign-hero__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 0 20px 28px;
    text-align: center;
  }
  .campaign-hero__eyebrow {
    margin: 0 0 10px;
    font-family: var(--font-label);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--clr-accent);
  }
  .campaign-hero__title {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 9vw, 4.6rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: #fff;
  }
  .campaign-hero__sub {
    max-width: 36ch;
    margin: 0 auto 20px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }
  .campaign-hero__ctas {
    display: flex;
    justify-content: center;
    gap: 10px;
  }
  .campaign-hero__ctas .btn {
    flex: 1 1 0;
    max-width: 210px;
    justify-content: center;
    white-space: nowrap;
  }
  .campaign-hero__btn-alt {
    background: rgba(0, 0, 0, 0.35);
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }

  @media (min-width: 769px) {
    .campaign-hero--split .campaign-hero__media { grid-template-columns: 1fr 1fr; }
    .campaign-hero--split .campaign-hero__frame--2 { display: block; }
    .campaign-hero__frame { aspect-ratio: auto; height: min(86vh, 920px); }
    .campaign-hero::after { inset: 50% 0 0; }
    .campaign-hero__content { padding-bottom: 56px; }
    .campaign-hero__sub { font-size: 1.05rem; }
  }
</style>

{% schema %}
{
  "name": "Campaign hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Portrait (4:5) works best. Phones show this one, full width."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second image (optional)",
      "info": "Sits beside the first from tablet width up. Phones show the first image only."
    },
    {
      "type": "text",
      "id": "image_2_alt",
      "label": "Second image description"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "btn_1_label",
      "label": "First button text"
    },
    {
      "type": "url",
      "id": "btn_1_url",
      "label": "First button link"
    },
    {
      "type": "text",
      "id": "btn_2_label",
      "label": "Second button text"
    },
    {
      "type": "url",
      "id": "btn_2_url",
      "label": "Second button link"
    },
    {
      "type": "checkbox",
      "id": "page_heading",
      "label": "Use the shop name as the page's main heading (hidden on screen)",
      "default": true
    }
  ],
  "presets": [
    { "name": "Campaign hero" }
  ]
}
{% endschema %}
