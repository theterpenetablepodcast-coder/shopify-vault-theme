{%- comment -%}
  The Club is a separate brand sitting inside this storefront, so its pages get
  their own footer lockup and voice. Sections can't see the layout's
  is_club_page, so the shared detect snippet resolves it here.
{%- endcomment -%}
{%- capture club_flag -%}{%- render 'club-detect' -%}{%- endcapture -%}
{%- assign club_flag = club_flag | strip -%}
{%- assign footer_is_club = false -%}
{%- if club_flag == 'true' -%}
  {%- assign footer_is_club = true -%}
{%- endif -%}

<footer class="site-footer{% if footer_is_club %} site-footer--club{% endif %}" role="contentinfo">
  <div class="page-width">

    <div class="footer-grid">

      <!-- Brand column -->
      <div class="footer-brand">
        {%- if footer_is_club -%}
          <a href="{{ routes.root_url }}collections/the-cultivators-club"
             class="cg-footer__brand"
             aria-label="The Cultivators Club">
            <img src="{{ 'cc-monogram-cream.png' | asset_url }}"
                 alt=""
                 class="cg-footer__mono"
                 width="36" height="36"
                 loading="lazy">
            <span class="cg-footer__wordmark">The Cultivators <em>Club</em></span>
          </a>

          <p class="footer-brand__tagline">
            {{ section.settings.club_about | default: 'A closed line for the people who cultivate the culture. Made in small numbers, built to outlast the trend, members only.' }}
          </p>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="vault-logo" aria-label="{{ shop.name }}">
            <div class="vault-logo__icon" style="width:36px;height:36px;">
              {% render 'wrc-mark' %}
            </div>
            <div class="vault-logo__text">
              {{ shop.name }}
              <span>{{ section.settings.tagline | default: 'Australian Owned' }}</span>
            </div>
          </a>

          <p class="footer-brand__tagline">
            {{ section.settings.about | default: 'Australian owned streetwear, accessories and grow gear. Small batches, shipped locally, built with the community around it.' }}
          </p>
        {%- endif -%}

        <!-- Social links. Skipped entirely when none are set, so the row
             doesn't contribute its top margin to an empty box. -->
        {%- if section.settings.instagram != blank or section.settings.twitter != blank or section.settings.tiktok != blank -%}
        <div class="footer-social" style="margin-top:24px;">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" class="social-link" aria-label="Instagram" target="_blank" rel="noopener">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.twitter != blank -%}
            <a href="{{ section.settings.twitter }}" class="social-link" aria-label="X / Twitter" target="_blank" rel="noopener">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok != blank -%}
            <a href="{{ section.settings.tiktok }}" class="social-link" aria-label="TikTok" target="_blank" rel="noopener">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.34 6.34 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.77a8.16 8.16 0 004.77 1.52V6.84a4.84 4.84 0 01-1-.15z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
        {%- endif -%}
      </div>

      <!-- Link columns -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div {{ block.shopify_attributes }}>
            <h3 class="footer-heading">{{ block.settings.heading }}</h3>
            <ul class="footer-links" role="list">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Newsletter -->
      {%- if section.settings.show_newsletter -%}
        <div>
          {%- if footer_is_club -%}
            {%- comment -%} Matches the wording on thecultivatorsclub.store {%- endcomment -%}
            <h3 class="footer-heading">{{ section.settings.club_newsletter_heading | default: 'GET FIRST ACCESS' }}</h3>
            <p style="font-family:var(--font-body);font-size:0.9rem;color:var(--clr-silver-dim);line-height:1.7;margin-bottom:16px;">
              {{ section.settings.club_newsletter_desc | default: 'New pieces, restocks and collab launches — before anyone else.' }}
            </p>
          {%- else -%}
            <h3 class="footer-heading">{{ section.settings.newsletter_heading | default: 'THE MAILING LIST' }}</h3>
            <p style="font-family:var(--font-body);font-size:0.9rem;color:var(--clr-silver-dim);line-height:1.7;margin-bottom:16px;">
              {{ section.settings.newsletter_desc | default: 'New prints, restocks and the occasional bit of news.' }}
            </p>
          {%- endif -%}
          <div class="footer-newsletter">
            {%- form 'customer', id: 'footer-newsletter' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter-form">
                <input type="email"
                       name="contact[email]"
                       class="newsletter-input"
                       placeholder="YOUR@EMAIL.COM"
                       required
                       autocomplete="email"
                       aria-label="Email address">
                <button type="submit" class="newsletter-submit">ENTER</button>
              </div>
            {%- endform -%}
          </div>
        </div>
      {%- endif -%}

    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p class="footer-legal">
        {%- if footer_is_club -%}
          &copy; {{ 'now' | date: '%Y' }} The Cultivators Club.
          &nbsp;&bull;&nbsp;<a href="{{ routes.root_url }}">The Wild Vault</a>
        {%- else -%}
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        {%- endif -%}
        {%- if section.settings.show_policy_links -%}
          {%- if shop.privacy_policy != blank -%}
            &nbsp;&bull;&nbsp;<a href="{{ shop.privacy_policy.url }}">Privacy</a>
          {%- endif -%}
          {%- if shop.terms_of_service != blank -%}
            &nbsp;&bull;&nbsp;<a href="{{ shop.terms_of_service.url }}">Terms</a>
          {%- endif -%}
          {%- if shop.refund_policy != blank -%}
            &nbsp;&bull;&nbsp;<a href="{{ shop.refund_policy.url }}">Returns</a>
          {%- endif -%}
          {%- if shop.shipping_policy != blank -%}
            &nbsp;&bull;&nbsp;<a href="{{ shop.shipping_policy.url }}">Shipping</a>
          {%- endif -%}
          &nbsp;&bull;&nbsp;<a href="/pages/contact">Contact</a>
        {%- endif -%}
      </p>

      <!-- Payment icons -->
      <div style="display:flex;gap:8px;align-items:center;" aria-label="Payment methods">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'payment-icon' }}
        {%- endfor -%}
      </div>
    </div>

  </div>
</footer>

<style>
  .payment-icon { height: 24px; filter: grayscale(100%) brightness(0.6); transition: filter 0.3s ease; }
  .payment-icon:hover { filter: grayscale(0%) brightness(1); }

  /* ── Cultivators Club footer lockup ──
     Mirrors the Club header rather than reusing .vault-logo, which is bolt
     upright Archivo at weight 800 and reads as the wrong brand even once the
     cg-page palette has recoloured it. */
  .cg-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
  }

  .cg-footer__mono {
    width: 36px;
    height: 36px;
    object-fit: contain;
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }

  .cg-footer__brand:hover .cg-footer__mono { opacity: 1; }

  .cg-footer__wordmark {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 300;
    letter-spacing: 0.06em;
    text-transform: none;
    color: #EDE8DC;
    white-space: nowrap;
    text-shadow: none;
  }

  .cg-footer__wordmark em {
    font-style: italic;
    color: #B8A882;
  }

  .site-footer--club .footer-heading {
    font-family: 'Montserrat', sans-serif;
    font-weight: 500;
    letter-spacing: 0.3em;
  }

  @media (max-width: 480px) {
    .cg-footer__wordmark { font-size: 1rem; }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Logo tagline",
      "default": "Australian Owned"
    },
    {
      "type": "textarea",
      "id": "about",
      "label": "About text"
    },
    {
      "type": "header",
      "content": "Cultivators Club footer"
    },
    {
      "type": "paragraph",
      "content": "Shown only on Club pages, which get their own footer lockup and voice."
    },
    {
      "type": "textarea",
      "id": "club_about",
      "label": "Club about text"
    },
    {
      "type": "text",
      "id": "club_newsletter_heading",
      "label": "Club newsletter heading",
      "default": "GET FIRST ACCESS"
    },
    {
      "type": "textarea",
      "id": "club_newsletter_desc",
      "label": "Club newsletter description",
      "default": "New pieces, restocks and collab launches — before anyone else."
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "text",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "twitter",
      "label": "X / Twitter URL"
    },
    {
      "type": "text",
      "id": "tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "THE MAILING LIST"
    },
    {
      "type": "textarea",
      "id": "newsletter_desc",
      "label": "Newsletter description"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "NAVIGATE"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "SHOP", "menu": "main-menu" } },
        { "type": "link_list", "settings": { "heading": "INFO", "menu": "footer" } }
      ]
    }
  ]
}
{% endschema %}
