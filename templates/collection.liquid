          {%- elsif signature_col.products.first.featured_image -%}
            <img src="{{ signature_col.products.first.featured_image | img_url: '900x700', crop: 'center' }}" alt="{{ signature_col.title | escape }}" width="900" height="700" loading="lazy">
          {%- else -%}
            <img src="{{ 'collection-the-wrc-signature.png' | asset_url }}" alt="The WRC Signature" width="900" height="700" loading="lazy">
          {%- endif -%}
          <div class="club-entry__overlay club-entry__overlay--gold"></div>
          <div class="club-entry__bracket club-entry__bracket--tl club-entry__bracket--gold"></div>
          <div class="club-entry__bracket club-entry__bracket--br club-entry__bracket--gold"></div>
          <div class="club-entry__count-badge club-entry__count-badge--gold">{{ signature_col.products_count }}<span>PIECES</span></div>
        </div>
        <div class="club-entry__body club-entry__body--gold">
          <div>
            <p class="club-entry__eyebrow club-entry__eyebrow--gold">PREMIUM RANGE</p>
            <h3 class="club-entry__title club-entry__title--gold">THE WRC SIGNATURE</h3>
            <p class="club-entry__desc">The flagship line. Heavier weight, refined detail, elevated construction — WRC at its finest.</p>
          </div>
          <div class="club-entry__foot">
            <span class="club-entry__cta club-entry__cta--gold">ENTER<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
          </div>
