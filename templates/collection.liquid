            <img src="{{ access_col.image | img_url: '1200x800', crop: 'center' }}"
                 alt="{{ access_col.title | escape }}"
                 width="1200" height="800" loading="lazy">
          {%- elsif access_col.products.first.featured_image -%}
            <img src="{{ access_col.products.first.featured_image | img_url: '1200x800', crop: 'center' }}"
                 alt="{{ access_col.title | escape }}"
                 width="1200" height="800" loading="lazy">
          {%- else -%}
            <div class="club-entry__no-img" aria-hidden="true"></div>
          {%- endif -%}
          <div class="club-entry__overlay"></div>
        </div>
        <div class="club-entry__body">
          <p class="club-entry__eyebrow">Everyday Carry</p>
          <h3 class="club-entry__title">The<br><em>Accessories</em></h3>
          <p class="club-entry__desc">Caps, bags, footwear and the bits that travel with you. Made to be used, not saved.</p>
          <div class="club-entry__foot">
            <span class="club-entry__cta">
              Explore
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </div>
        </div>
      </a>

    </div>
  </div>
</div>
{%- endif -%}

<!-- ============================================================
     WRC CLOTHING HUB — four entry panels
============================================================ -->


<!-- ============================================================
     COLLECTION BODY — range tabs, filters, products
============================================================ -->
{%- comment -%}
  The Club hub is curated navigation only; every other collection gets the
  product grid.

  Clothing used to open on four range tiles that had to be chosen between
  before a single product showed, with the full range 1,600px further down
  a phone. The ranges are now a row of tabs over one grid. On Clothing a tab
  filters the grid in place (vault.js initLineFilter, reading the data-lines
  each card carries); on a range's own page the tabs are plain links.
{%- endcomment -%}
{%- unless is_hub -%}

{%- assign line_handles = 'the-roots,the-movement,the-wrc-signature,the-kit-and-carry' | split: ',' -%}
{%- assign line_keys    = 'roots,movement,signature,kit' | split: ',' -%}
{%- assign line_labels  = 'The Roots|The Movement|Signature|Kit & Carry' | split: '|' -%}
{%- assign line_notes   = 'Everyday essentials at an accessible price.|Advocacy and purpose. Pieces that say something.|The flagship line. Heavier weights, refined detail.|Caps and the details that finish the look.' | split: '|' -%}
{%- assign all_note     = 'Every piece, every range.' -%}

{%- comment -%}
  Club grids keep 24 a page. Wild Vault collections show up to 48, which
  puts all of Clothing on one page so the tabs can filter all of it.
{%- endcomment -%}
{%- assign page_size = 48 -%}
{%- if is_club -%}{%- assign page_size = 24 -%}{%- endif -%}

{%- paginate collection.products by page_size -%}

{%- assign filter_in_place = false -%}
{%- if is_wrc_hub and paginate.pages <= 1 -%}{%- assign filter_in_place = true -%}{%- endif -%}

{%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
{%- assign active_filters = 0 -%}
{%- for filter in collection.filters -%}
  {%- if filter.type == 'price_range' -%}
    {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
      {%- assign active_filters = active_filters | plus: 1 -%}
    {%- endif -%}
  {%- else -%}
    {%- assign active_filters = active_filters | plus: filter.active_values.size -%}
  {%- endif -%}
{%- endfor -%}

<div class="section collection-body{% unless is_club %} collection-body--vault{% endunless %}"{% if is_club %} style="background:#080808;"{% endif %}>
  <div class="page-width">

    {%- if is_wrc -%}
      <nav class="line-tabs" aria-label="Clothing ranges"{% if filter_in_place %} data-line-filter{% endif %}>
        <div class="line-tabs__track">
          <a href="/collections/merch" class="line-tab{% if is_wrc_hub %} is-active{% endif %}" data-line="all" data-note="{{ all_note | escape }}"{% if is_wrc_hub %} aria-current="page"{% endif %}>All</a>
          {%- for h in line_handles -%}
            {%- assign i = forloop.index0 -%}
            <a href="/collections/{{ h }}" class="line-tab{% if collection.handle == h %} is-active{% endif %}" data-line="{{ line_keys[i] }}" data-note="{{ line_notes[i] | escape }}"{% if collection.handle == h %} aria-current="page"{% endif %}>{{ line_labels[i] | escape }}</a>
          {%- endfor -%}
        </div>
      </nav>
      {%- if filter_in_place -%}
        <p class="line-note" data-line-note>{{ all_note }}</p>
      {%- endif -%}
    {%- endif -%}

    <div class="collection-layout">

      <!-- Filters: a sidebar on desktop, a slide-in panel on phones and tablets -->
      <aside class="filter-panel" id="filter-panel" aria-label="Collection filters">
        {%- comment -%}
          These inputs used to call this.form.submit() with no <form> around
          them, so ticking a filter threw an error and did nothing, on every
          collection. Empty fields are disabled on submit to keep them out of
          the URL.
        {%- endcomment -%}
        <form action="{{ collection.url }}" method="get" class="filter-form"
              onsubmit="[].forEach.call(this.elements, function (el) { if (el.name && el.value === '') el.disabled = true; });">

          {%- if is_club -%}
            <div class="filter-panel__title">FILTERS</div>
          {%- else -%}
            <div class="filter-panel__head">
              <p class="filter-panel__title">FILTERS</p>
              <button type="button" class="filter-panel__close" data-filter-close aria-label="Close filters">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          {%- endif -%}

          {%- if sort_by != collection.default_sort_by -%}
            <input type="hidden" name="sort_by" value="{{ sort_by }}">
          {%- endif -%}
          {%- if filter_in_place -%}
            <input type="hidden" name="line" value="" data-line-input>
          {%- endif -%}

          {%- for filter in collection.filters -%}
            <div class="filter-group">
              <p class="filter-group__label">{{ filter.label | upcase }}</p>

              {%- case filter.type -%}
                {%- when 'price_range' -%}
                  {%- assign min_val = '' -%}
                  {%- assign max_val = '' -%}
                  {%- if filter.min_value.value != nil -%}{%- assign min_val = filter.min_value.value | money_without_currency | remove: ',' -%}{%- endif -%}
                  {%- if filter.max_value.value != nil -%}{%- assign max_val = filter.max_value.value | money_without_currency | remove: ',' -%}{%- endif -%}
                  {%- if is_club -%}
                    <div style="display:flex;gap:8px;align-items:center;">
                      <input type="number"
                             name="{{ filter.min_value.param_name }}"
                             value="{{ min_val }}"
                             min="0"
                             style="background:var(--clr-dark);border:1px solid var(--clr-border);color:var(--clr-white);font-family:var(--font-label);font-size:0.65rem;padding:6px 10px;width:80px;border-radius:var(--radius);outline:none;"
                             placeholder="MIN"
                             aria-label="Minimum price">
                      <span style="color:var(--clr-silver-dim);font-family:var(--font-label);font-size:0.65rem;">—</span>
                      <input type="number"
                             name="{{ filter.max_value.param_name }}"
                             value="{{ max_val }}"
                             min="0"
                             style="background:var(--clr-dark);border:1px solid var(--clr-border);color:var(--clr-white);font-family:var(--font-label);font-size:0.65rem;padding:6px 10px;width:80px;border-radius:var(--radius);outline:none;"
                             placeholder="MAX"
                             aria-label="Maximum price">
                    </div>
                  {%- else -%}
                    <div class="filter-price">
                      <input type="number" name="{{ filter.min_value.param_name }}" value="{{ min_val }}"
                             min="0" step="any" inputmode="decimal" placeholder="Min $" aria-label="Minimum price">
                      <span class="filter-price__sep" aria-hidden="true">to</span>
                      <input type="number" name="{{ filter.max_value.param_name }}" value="{{ max_val }}"
                             min="0" step="any" inputmode="decimal" placeholder="Max $" aria-label="Maximum price">
                    </div>
                    <button type="submit" class="btn btn--outline filter-price__apply">Apply price</button>
                  {%- endif -%}

                {%- else -%}
                  {%- for value in filter.values -%}
                    {%- assign fid = 'filter-' | append: filter.param_name | handleize | append: '-' | append: forloop.index -%}
                    <div class="filter-option">
                      <input type="checkbox"
                             id="{{ fid }}"
                             name="{{ value.param_name }}"
                             value="{{ value.value }}"
                             {% if value.active %}checked{% endif %}
                             {% if value.count == 0 and value.active == false %}disabled{% endif %}
                             onchange="if (this.form.requestSubmit) { this.form.requestSubmit(); } else { this.form.submit(); }">
                      <label for="{{ fid }}">{{ value.label }} <span class="filter-option__count">({{ value.count }})</span></label>
                    </div>
                  {%- endfor -%}
              {%- endcase -%}
            </div>
          {%- endfor -%}

          {%- if is_club -%}
            {%- if collection.filters.size > 0 -%}
              <a href="{{ collection.url }}" class="btn btn--ghost" style="width:100%;justify-content:center;font-size:0.65rem;padding:10px 16px;margin-top:12px;">
                CLEAR FILTERS
              </a>
            {%- endif -%}
          {%- elsif active_filters > 0 -%}
            <a href="{{ collection.url }}{% if sort_by != collection.default_sort_by %}?sort_by={{ sort_by }}{% endif %}" class="filter-panel__clear">Clear all filters</a>
          {%- endif -%}
        </form>
      </aside>
      {%- unless is_club -%}
        <div class="filter-backdrop" data-filter-close hidden></div>
      {%- endunless -%}

      <!-- Products -->
      <div class="collection-main">
        <div class="collection-toolbar">
          <p class="collection-count">
            {%- if is_club -%}
              <span>{{ collection.products_count }}</span> ITEMS SECURED
            {%- else -%}
              <span data-item-count>{{ collection.products_count }}</span> <span data-item-count-word>{% if collection.products_count == 1 %}item{% else %}items{% endif %}</span>
            {%- endif -%}
          </p>

          <div class="collection-toolbar__actions">
            {%- unless is_club -%}
              {%- if collection.filters.size > 0 -%}
                <button type="button" class="toolbar-btn" data-filter-toggle aria-controls="filter-panel" aria-expanded="false">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="7" y1="12" x2="17" y2="12"/><line x1="10" y1="17" x2="14" y2="17"/></svg>
                  Filter{% if active_filters > 0 %} <span class="toolbar-btn__count">{{ active_filters }}</span>{% endif %}
                </button>
              {%- endif -%}
            {%- endunless -%}
            {%- comment -%}
              Keeps every other parameter (filters, range) when the sort changes.
              window.URL, not URL: inside an inline handler a bare URL resolves
              to document.URL, which is a string.
            {%- endcomment -%}
            <select class="sort-select" aria-label="Sort products"
                    onchange="var u = new window.URL(window.location.href); u.searchParams.set('sort_by', this.value); u.searchParams.delete('page'); window.location.href = u.toString();">
              <option value="manual"             {% if sort_by == 'manual' %}selected{% endif %}>Featured</option>
              <option value="best-selling"       {% if sort_by == 'best-selling' %}selected{% endif %}>Best selling</option>
              <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
              <option value="price-ascending"    {% if sort_by == 'price-ascending' %}selected{% endif %}>Price: low–high</option>
              <option value="price-descending"   {% if sort_by == 'price-descending' %}selected{% endif %}>Price: high–low</option>
              <option value="title-ascending"    {% if sort_by == 'title-ascending' %}selected{% endif %}>A–Z</option>
              <option value="title-descending"   {% if sort_by == 'title-descending' %}selected{% endif %}>Z–A</option>
            </select>
          </div>
        </div>

        {%- if collection.products.size > 0 -%}
          <div class="product-grid{% if is_club %} product-grid--club{% endif %}" data-line-grid>
            {%- for product in collection.products -%}
              {%- assign card_lines = '' -%}
              {%- if filter_in_place -%}
                {%- for c in product.collections -%}
                  {%- case c.handle -%}
                    {%- when 'the-roots' -%}{%- assign card_lines = card_lines | append: ' roots' -%}
                    {%- when 'the-movement' -%}{%- assign card_lines = card_lines | append: ' movement' -%}
                    {%- when 'the-wrc-signature' -%}{%- assign card_lines = card_lines | append: ' signature' -%}
                    {%- when 'the-kit-and-carry' -%}{%- assign card_lines = card_lines | append: ' kit' -%}
                  {%- endcase -%}
                {%- endfor -%}
              {%- endif -%}
              {%- render 'product-card', product: product, show_vendor: true, allow_club: is_club, lines: card_lines -%}
            {%- endfor -%}
          </div>

          {%- if filter_in_place -%}
            <div class="line-empty" data-line-empty hidden>
              <p class="line-empty__text">Nothing in this range matches those filters.</p>
              <a href="{{ collection.url }}" class="btn btn--outline">Clear filters</a>
            </div>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="pagination__link">← Prev</a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="pagination__link">{{ part.title }}</a>
                {%- else -%}
                  {%- comment -%} Non-link parts are the current page or an ellipsis. {%- endcomment -%}
                  {%- assign current_label = paginate.current_page | append: '' -%}
                  {%- if part.title == current_label -%}
                    <span class="pagination__link is-current" aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span class="pagination__gap">{{ part.title }}</span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="pagination__link">Next →</a>
              {%- endif -%}
            </nav>
          {%- endif -%}

        {%- else -%}
          <div class="collection-empty">
            <p class="collection-empty__title">Nothing here yet</p>
            <p class="collection-empty__text">No products match those filters.</p>
            <a href="{{ collection.url }}" class="btn btn--outline">Clear filters</a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>
{%- endpaginate -%}
{%- endunless -%}

{%- endif -%}
