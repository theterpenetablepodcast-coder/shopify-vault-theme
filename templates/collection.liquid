          <div class="club-entry__bracket club-entry__bracket--br club-entry__bracket--green"></div>
          <div class="club-entry__count-badge club-entry__count-badge--green">{{ movement_col.products_count }}<span>PIECES</span></div>
        </div>
        <div class="club-entry__body club-entry__body--green">
          <div>
            <p class="club-entry__eyebrow club-entry__eyebrow--green">ADVOCACY & PURPOSE</p>
