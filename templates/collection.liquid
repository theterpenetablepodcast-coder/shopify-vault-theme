{% layout 'theme' %}

{%- comment -%}
  Retired collections. Shopify's URL redirects only fire on a 404, and these
  collections still exist (emptied, not deleted), so the redirect never runs
  and the old URL would render an empty category page. Send visitors on
  ourselves until the collections are removed in admin.
{%- endcomment -%}
{%- assign retired_handles = 'secured,the-drops' | split: ',' -%}
{%- comment -%}
  Where each retired handle sends people. The Drops was replaced by Core when
  the Club moved off the drop model, so its traffic belongs there rather than
  on the generic index.
{%- endcomment -%}
{%- assign retired_target = '/collections' -%}
{%- if collection.handle == 'the-drops' -%}
  {%- assign retired_target = '/collections/core' -%}
{%- endif -%}
{%- if retired_handles contains collection.handle -%}
  <meta http-equiv="refresh" content="0; url={{ retired_target }}">
  <link rel="canonical" href="{{ shop.url }}{{ retired_target }}">
  <div class="section section--lg" style="min-height:60vh;display:flex;align-items:center;justify-content:center;text-align:center;">
    <div>
      <h1 style="font-family:var(--font-display);font-size:clamp(1.8rem,5vw,3rem);font-weight:800;letter-spacing:-0.02em;text-transform:uppercase;color:var(--clr-white);margin-bottom:16px;">
        This section has moved
      </h1>
      <p style="font-family:var(--font-body);font-size:1.05rem;color:var(--clr-silver);margin-bottom:32px;">
        Taking you to the shop&hellip;
      </p>
      <a href="{{ retired_target }}" class="btn btn--primary">SHOP THE RANGE</a>
    </div>
  </div>
  <script>window.location.replace({{ retired_target | json }});</script>

{%- elsif collection.handle == 'genetics' -%}
{%- comment -%}
  Genetics is retired, but /collections/genetics is still the third most-visited
  landing page on the site — 26 sessions in 90 days, ahead of /collections and
  every product page. Those arrivals are growers coming back from bookmarks and
  old links, and the blanket redirect dropped them onto a grid of t-shirts with
  no explanation. So this handle gets a real page instead: say what happened,
  show the gear that still serves them, give them a reason to come back.

  Deliberately says nothing about WHY genetics went. Not the visitor's business
  and not a claim worth making in writing.
{%- endcomment -%}
<link rel="canonical" href="{{ shop.url }}/collections/genetics">
<div class="section">
  <div class="page-width" style="max-width:900px;">

    <div style="margin-bottom:44px;padding-bottom:32px;border-bottom:1px solid var(--clr-border);">
      <p class="section-eyebrow" style="justify-content:flex-start;">No longer stocked</p>
      <h1 class="section-title" style="text-align:left;">We don't carry genetics anymore</h1>
      <p style="font-family:var(--font-body);font-size:1.05rem;color:var(--clr-silver);line-height:1.75;margin-top:20px;max-width:620px;">
        That side of the shop is closed. What's still here is the gear that gets you
        from cut to cure, made and sent from Victoria &mdash; and the people who've been
        doing this a long time.
      </p>
    </div>

    {%- assign gear_handles = 'the-wrc-scrog-hooks-6-pack,plantguard-clone-shippers,bra-clips-v2-gear-lock-lst-clips,wrc-yoyo-rope-tidy-4-pack' | split: ',' -%}
    {%- assign gear_shown = 0 -%}
    {%- capture gear_cards -%}
      {%- for h in gear_handles -%}
        {%- assign gear = all_products[h] -%}
        {%- if gear != blank and gear.available -%}
          {%- assign gear_shown = gear_shown | plus: 1 -%}
          <article class="blog-card">
            <a class="blog-card__link" href="{{ gear.url }}">
              {%- if gear.featured_image != blank -%}
                <div class="blog-card__image-wrap">
                  <img src="{{ gear.featured_image | image_url: width: 600 }}"
                       alt="{{ gear.featured_image.alt | default: gear.title | escape }}"
                       loading="lazy" width="600" height="375">
                </div>
              {%- endif -%}
              <div class="blog-card__body">
                <p class="blog-card__date">From {{ gear.price | money }}</p>
                <h3 class="blog-card__title" style="font-size:0.95rem;">{{ gear.title }}</h3>
                <span class="blog-card__more">View &rarr;</span>
              </div>
            </a>
          </article>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if gear_shown > 0 -%}
      <p class="section-eyebrow" style="justify-content:flex-start;margin-bottom:20px;">Still in the shop</p>
      <div class="blog-grid" style="grid-template-columns:repeat(auto-fit,minmax(190px,1fr));">
        {{ gear_cards }}
      </div>
    {%- endif -%}

    <div style="margin-top:48px;display:flex;flex-wrap:wrap;gap:12px;">
      <a href="/collections/accessories-grow-gear" class="btn btn--primary">ALL GROW GEAR</a>
      <a href="/blogs/terpene-table" class="btn btn--outline">THE TERPENE TABLE</a>
    </div>

    <p style="font-family:var(--font-label);font-size:0.68rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--clr-silver-dim);margin-top:36px;">
      Rooted in Fire. Grown for Freedom.
    </p>

  </div>
</div>

{%- else -%}

{%- capture club_handles -%}{%- render 'club-handles' -%}{%- endcapture -%}
{%- assign club_list = club_handles | strip | split: ',' -%}

{%- assign is_club      = false -%}
{%- assign is_uniform   = false -%}
{%- assign is_core      = false -%}
{%- assign is_collabs   = false -%}
{%- assign is_accessories = false -%}
{%- assign is_hub       = false -%}

{%- assign is_wrc       = false -%}
{%- assign is_roots     = false -%}
{%- assign is_movement  = false -%}
{%- assign is_signature = false -%}
{%- assign is_kit_carry = false -%}
{%- assign is_wrc_hub   = false -%}

{%- comment -%}
  ── Cultivators Club flags ──
  Club membership comes from snippets/club-handles.liquid so a new Club
  collection is a one-line edit there rather than six edits across the theme.
  The sub-range flags below stay explicit — each one is a specific page, and
  the hub is whatever's left over once they're excluded.
{%- endcomment -%}
{%- if club_list contains collection.handle or collection.handle contains 'cultivator' -%}
  {%- assign is_club = true -%}
{%- endif -%}
{%- if collection.handle == 'the-uniform' -%}
  {%- assign is_uniform = true -%}
{%- endif -%}
{%- if collection.handle == 'core' -%}
  {%- assign is_core = true -%}
{%- endif -%}
{%- if collection.handle == 'collabs' -%}
  {%- assign is_collabs = true -%}
{%- endif -%}
{%- if collection.handle == 'club-accessories' -%}
  {%- assign is_accessories = true -%}
{%- endif -%}
{%- if is_club and is_uniform == false and is_core == false and is_collabs == false and is_accessories == false -%}
  {%- assign is_hub = true -%}
{%- endif -%}

{%- comment -%} ── WRC Clothing flags ── {%- endcomment -%}
{%- if collection.handle == 'merch' -%}
  {%- assign is_wrc = true -%}
{%- endif -%}
{%- if collection.handle == 'the-roots' -%}
  {%- assign is_wrc   = true -%}
  {%- assign is_roots = true -%}
{%- endif -%}
{%- if collection.handle == 'the-movement' -%}
  {%- assign is_wrc      = true -%}
  {%- assign is_movement = true -%}
{%- endif -%}
{%- if collection.handle == 'the-wrc-signature' -%}
  {%- assign is_wrc       = true -%}
  {%- assign is_signature = true -%}
{%- endif -%}
{%- if collection.handle == 'the-kit-and-carry' -%}
  {%- assign is_wrc       = true -%}
  {%- assign is_kit_carry = true -%}
{%- endif -%}
{%- if is_wrc and is_roots == false and is_movement == false and is_signature == false and is_kit_carry == false -%}
  {%- assign is_wrc_hub = true -%}
{%- endif -%}

<!-- ============================================================
     COLLECTION HERO
     - WRC sub-collections: full-width banner PNG (title is IN the image)
     - Club collections / other: hero from collection.image if set
============================================================ -->

{%- comment -%} Resolve collection banner asset URL {%- endcomment -%}
{%- assign wrc_banner = '' -%}
{%- if is_hub       -%}{%- assign wrc_banner = 'collection-the-cultivators-club.png' | asset_url -%}{%- endif -%}
{%- if is_roots     -%}{%- assign wrc_banner = 'collection-the-roots.png'            | asset_url -%}{%- endif -%}
{%- if is_movement  -%}{%- assign wrc_banner = 'collection-the-movement.png'         | asset_url -%}{%- endif -%}
{%- if is_signature -%}{%- assign wrc_banner = 'collection-the-wrc-signature.png'    | asset_url -%}{%- endif -%}
{%- if is_kit_carry -%}{%- assign wrc_banner = 'collection-the-kit-and-carry.png'    | asset_url -%}{%- endif -%}

{%- assign hero_src = '' -%}
{%- if wrc_banner != '' -%}
  {%- assign hero_src = wrc_banner -%}
{%- elsif collection.image -%}
  {%- assign hero_src = collection.image | img_url: '2000x' -%}
{%- endif -%}

{%- if hero_src != '' -%}
  <div style="width:100%;overflow:hidden;position:relative;background:var(--clr-black);
              aspect-ratio:4/1;
              ">
    <style>
      @media (max-width:768px) { .collection-hero-wrap { aspect-ratio: 16/9 !important; } }
      @media (max-width:480px) { .collection-hero-wrap { aspect-ratio: 4/3  !important; } }
    </style>
    <div class="collection-hero-wrap" style="width:100%;height:100%;aspect-ratio:4/1;overflow:hidden;position:relative;">
      <img src="{{ hero_src }}"
           alt="{{ collection.title | escape }}"
           style="width:100%;height:100%;object-fit:cover;{% if wrc_banner != '' %}object-position:center;filter:brightness(1);{% else %}filter:brightness(0.7);{% endif %}"
           loading="eager">
      <div style="position:absolute;bottom:0;left:0;right:0;height:55%;background:linear-gradient(to bottom,transparent,var(--clr-black));"></div>
      {%- if is_club -%}
        <div style="position:absolute;top:24px;left:50%;transform:translateX(-50%);font-family:'Montserrat',sans-serif;font-size:0.46rem;font-weight:500;color:rgba(237,232,220,0.55);letter-spacing:0.5em;text-transform:uppercase;white-space:nowrap;">
          The Cultivators Club
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<!-- Text panel -->
{%- comment -%}
  Where the banner already carries the title (Clothing, its ranges, the
  Club hub) the visible heading is dropped and a screen-reader one kept.
  Every other collection shows the full title.
{%- endcomment -%}
{%- assign show_title = true -%}
{%- if wrc_banner != '' -%}{%- assign show_title = false -%}{%- endif -%}
{%- comment -%}
  The Clothing banner is lettered too, so the page said CLOTHING three
  times (banner, eyebrow, heading) before a single product.
{%- endcomment -%}
{%- if is_wrc and hero_src != '' -%}{%- assign show_title = false -%}{%- endif -%}

<div style="background:{% if is_club %}#080808{% else %}var(--clr-black){% endif %};
            padding:{% if hero_src != '' %}clamp(18px,3vw,28px){% else %}clamp(40px,6vw,72px){% endif %} 0 clamp(20px,3vw,32px);
            border-bottom:1px solid {% if is_club %}rgba(184,168,130,0.12){% else %}var(--clr-border){% endif %};text-align:center;">
  <div class="page-width">
    {%- if is_club -%}
      <p style="font-family:'Montserrat',sans-serif;font-size:0.48rem;font-weight:500;letter-spacing:0.42em;color:#A89F8C;text-transform:uppercase;margin:0 0 16px;opacity:0.8;justify-content:center;display:flex;">The Cultivators Club</p>
    {%- elsif show_title -%}
      <p class="section-eyebrow">SHOP</p>
    {%- endif -%}
    {%- if show_title -%}
      {%- if is_club -%}
        <h1 style="font-family:'Cormorant Garamond',Georgia,serif;font-size:clamp(2.8rem,6vw,5rem);font-weight:300;color:#EDE8DC;letter-spacing:0.02em;line-height:1.1;text-transform:none;margin:0 0 12px;">
          {{ collection.title }}
        </h1>
      {%- else -%}
        <h1 class="section-title">{{ collection.title | upcase }}</h1>
      {%- endif -%}
    {%- else -%}
      <h1 class="sr-only">{{ collection.title }}</h1>
    {%- endif -%}
    {%- if collection.description != blank -%}
      {%- if is_club -%}
        {%- comment -%}
          Rendered unfiltered, unlike the branch below. The Club descriptions
          are written as several short beats and strip_html collapses them
          into one run-on block at this size, which is close to unreadable.
        {%- endcomment -%}
        <div class="cg-collection-desc">
          {{ collection.description }}
        </div>
      {%- else -%}
        <p class="section-desc collection-intro" data-collection-intro style="max-width:640px;margin:{% if show_title %}16px{% else %}8px{% endif %} auto 0;line-height:1.9;">
          {{ collection.description | replace: '</p>', '</p> ' | replace: '<br>', ' ' | strip_html | strip }}
        </p>
        <button type="button" class="collection-intro__more" data-collection-intro-more hidden>Read more</button>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>


<!-- ============================================================
     CULTIVATORS CLUB GATE — premium botanical access screen
============================================================ -->
{%- if is_club -%}
<div id="vault-gate">

  <!-- Soft dark overlay -->
  <div id="vault-gate__bg"></div>

  <div id="vault-gate__panel">

    <!-- Eyebrow mark -->
    <p class="cg-gate__eyebrow">THE CULTIVATORS CLUB</p>

    <!-- Club monogram (reveals on unlock) -->
    <div id="gate-botanical" aria-hidden="true">
      <img src="{{ 'cc-monogram-cream.png' | asset_url }}" alt="" class="cg-monogram" width="500" height="500">
    </div>

    <!-- Headline -->
    <div class="cg-gate__headline-wrap">
      <h1 class="cg-gate__title">The Cultivators<br><em>Club</em></h1>
      <div class="cg-gate__rule" aria-hidden="true"></div>
      <p class="cg-gate__sub">Members Only</p>
    </div>

    <!-- Status line -->
    <p id="gate-status" class="cg-gate__status">Enter your name to unlock the Club</p>

    <!-- Name entry -->
    <div id="gate-password-wrap" class="cg-gate__form">
      <div class="cg-gate__input-wrap">
        <input type="text"
               id="gate-password-input"
               placeholder="Your name"
               maxlength="64"
               autocomplete="off"
               spellcheck="false"
               aria-label="Enter your name to access the Cultivators Club">
      </div>
      <p id="gate-input-error" aria-live="polite"></p>
    </div>

    <button id="gate-btn" onclick="crackTheVault()">Enter</button>

    <div id="gate-hint">
      <span>A private community of growers &amp; cultivators</span>
    </div>

  </div>
</div>

<style>
/* ── Cultivators Club Gate — Premium Botanical ── */

/* CSS custom properties scoped to gate */
#vault-gate {
  --cg-cream:    #EDE8DC;
  --cg-taupe:    #B8A882;
  --cg-dust:     #A89F8C;
  --cg-dark:     #080808;
  --cg-serif:    'Cormorant Garamond', Georgia, serif;
  --cg-sans:     'Montserrat', sans-serif;

  position: fixed;
  inset: 0;
  z-index: 4000;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow-y: auto;
}

#vault-gate__bg {
  position: fixed;
  inset: 0;
  background: rgba(8, 8, 8, 0.97);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

#vault-gate__panel {
  position: relative;
  z-index: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  padding: 48px 32px 56px;
  width: 100%;
  max-width: 460px;
  margin: auto;
}

/* Eyebrow */
.cg-gate__eyebrow {
  font-family: var(--cg-sans);
  font-size: 0.5rem;
  font-weight: 500;
  letter-spacing: 0.45em;
  color: var(--cg-taupe);
  text-transform: uppercase;
  margin: 0 0 36px;
  opacity: 0.8;
}

/* Botanical illustration */
#gate-botanical {
  width: 132px;
  height: 132px;
  margin-bottom: 30px;
  opacity: 0;
  transform: scale(0.94);
  animation: cgMonogramIn 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) 0.15s forwards;
}

.cg-monogram {
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  transition: filter 0.9s ease, transform 0.9s ease;
}

@keyframes cgMonogramIn {
  from { opacity: 0; transform: scale(0.94); }
  to   { opacity: 0.92; transform: scale(1); }
}

/* On unlock the mark warms and settles rather than animating stroke by stroke */
#gate-botanical.blooming .cg-monogram {
  filter: drop-shadow(0 0 18px rgba(237, 232, 220, 0.45));
  transform: scale(1.04);
}

@media (max-width: 600px) {
  #gate-botanical { width: 104px; height: 104px; margin-bottom: 24px; }
}

/* Gate headline */
.cg-gate__headline-wrap {
  margin-bottom: 32px;
}

.cg-gate__title {
  font-family: var(--cg-serif);
  font-weight: 300;
  font-size: clamp(2.6rem, 6vw, 3.6rem);
  color: var(--cg-cream);
  line-height: 1.15;
  letter-spacing: 0.01em;
  margin: 0 0 18px;
}

.cg-gate__title em {
  font-style: italic;
  font-weight: 300;
}

.cg-gate__rule {
  width: 48px;
  height: 1px;
  background: var(--cg-taupe);
  margin: 0 auto 16px;
  opacity: 0.5;
}

.cg-gate__sub {
  font-family: var(--cg-sans);
  font-size: 0.55rem;
  font-weight: 400;
  letter-spacing: 0.32em;
  color: var(--cg-dust);
  text-transform: uppercase;
  margin: 0;
}

/* Status line */
.cg-gate__status {
  font-family: var(--cg-sans);
  font-size: 0.5rem;
  font-weight: 300;
  letter-spacing: 0.22em;
  color: var(--cg-dust);
  text-transform: uppercase;
  min-height: 1em;
  margin: 0 0 24px;
  transition: color 0.4s;
}

.cg-gate__status.active {
  color: var(--cg-cream);
}

/* Input form */
.cg-gate__form {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: 100%;
  max-width: 280px;
  margin-bottom: 28px;
}

.cg-gate__input-wrap {
  width: 100%;
  border-bottom: 1px solid rgba(184, 168, 130, 0.4);
  transition: border-color 0.3s;
}

.cg-gate__input-wrap:focus-within {
  border-color: rgba(237, 232, 220, 0.7);
}

#gate-password-input {
  width: 100%;
  background: transparent;
  border: none;
  outline: none;
  color: var(--cg-cream);
  font-family: var(--cg-serif);
  font-weight: 300;
  font-size: 1.1rem;
  letter-spacing: 0.12em;
  text-align: center;
  padding: 10px 0 12px;
  caret-color: var(--cg-cream);
}

#gate-password-input::placeholder {
  color: rgba(184, 168, 130, 0.45);
  font-style: italic;
  font-size: 0.95rem;
  letter-spacing: 0.06em;
}

#gate-password-input.denied {
  animation: cgShake 0.4s ease;
  color: #c8876a;
}

@keyframes cgShake {
  0%, 100% { transform: translateX(0); }
  20%       { transform: translateX(-5px); }
  40%       { transform: translateX(5px); }
  60%       { transform: translateX(-3px); }
  80%       { transform: translateX(3px); }
}

#gate-input-error {
  font-family: var(--cg-sans);
  font-size: 0.48rem;
  color: #c8876a;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  min-height: 1em;
}

/* Enter button */
#gate-btn {
  font-family: var(--cg-serif);
  font-style: italic;
  font-weight: 400;
  font-size: 1rem;
  letter-spacing: 0.12em;
  color: var(--cg-dark);
  background: var(--cg-cream);
  border: none;
  padding: 14px 52px;
  border-radius: 1px;
  cursor: pointer;
  transition: background 0.25s, transform 0.2s, opacity 0.2s;
  margin-bottom: 40px;
}

#gate-btn:hover {
  background: #f5f0e8;
  transform: translateY(-1px);
}

#gate-btn:disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* Gate footnote */
#gate-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-family: var(--cg-sans);
  font-size: 0.48rem;
  font-weight: 300;
  color: var(--cg-dust);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  text-align: center;
  max-width: 320px;
  line-height: 1.8;
  opacity: 0.65;
  margin-bottom: 12px;
}

/* Gate exit animation */
#vault-gate.unlocking {
  pointer-events: none;
}

#vault-gate.unlocking #vault-gate__bg {
  animation: cgFade 1s 0.6s ease-out forwards;
}

#vault-gate.unlocking #vault-gate__panel {
  animation: cgSlideUp 0.9s 0.5s ease-out forwards;
}

@keyframes cgFade    { to { opacity: 0; } }
@keyframes cgSlideUp { to { opacity: 0; transform: translateY(-20px); } }

/* ── Mobile gate ── */
@media (max-width: 600px) {
  #vault-gate__panel {
    padding: 40px 24px 52px;
    min-height: 100svh;
    justify-content: center;
  }

  .cg-gate__title {
    font-size: 2.4rem;
  }

  #gate-botanical {
    width: 108px;
    height: 108px;
    margin-bottom: 26px;
  }

  .cg-gate__form {
    max-width: 100%;
  }

  #gate-btn {
    width: 100%;
  }
}
</style>

<script>
(function () {
  /* ── Auth storage key ───────────────────────────────────────── */
  var AUTH_KEY = 'wrc_club_auth_v1';

  /* ── Password check ─────────────────────────────────────────
     Stored as btoa('CULTIVATE') so plaintext is not in source.
     To change the password: replace PASS_HASH with btoa(NEW_PASSWORD)
  ──────────────────────────────────────────────────────────── */
  var PASS_HASH = 'Q1VMVElWQVRF';   /* = btoa('CULTIVATE') */

  /* ── Skip gate if already authenticated ─────────────────── */
  (function checkAuth() {
    try {
      if (localStorage.getItem(AUTH_KEY) === '1') {
        var gate = document.getElementById('vault-gate');
        if (gate) gate.style.display = 'none';
      }
    } catch(e) {}
  })();

  /* ── Unlock animation — botanical bloom ─────────────────── */
  function playUnlockAnimation() {
    var btn      = document.getElementById('gate-btn');
    var status   = document.getElementById('gate-status');
    var gate     = document.getElementById('vault-gate');
    var botanical= document.getElementById('gate-botanical');
    var pwWrap   = document.getElementById('gate-password-wrap');
    var hint     = document.getElementById('gate-hint');
    var headline = document.querySelector('.cg-gate__headline-wrap');

    /* Fade out form elements gracefully */
    var toFade = [btn, pwWrap, hint];
    toFade.forEach(function(el) {
      if (!el) return;
      el.style.transition = 'opacity 0.5s ease';
      el.style.opacity    = '0';
      el.style.pointerEvents = 'none';
    });

    /* Status messages cycling */
    var msgs  = ['Verifying membership…', 'Cultivating access…', 'Opening the vault…'];
    var mIdx  = 0;
    status.textContent = msgs[0];
    status.classList.add('active');
    var statusTimer = setInterval(function() {
      mIdx++;
      if (mIdx < msgs.length) {
        status.textContent = msgs[mIdx];
      }
    }, 800);

    /* Trigger botanical bloom after short delay */
    setTimeout(function() {
      if (botanical) botanical.classList.add('blooming');
    }, 400);

    /* Final reveal */
    setTimeout(function() {
      clearInterval(statusTimer);
      status.textContent = 'Welcome to the Club';
      status.style.fontStyle   = 'italic';
      status.style.letterSpacing = '0.08em';
      status.style.fontSize    = '0.65rem';
      status.style.color       = '#EDE8DC';
      status.style.fontFamily  = "'Cormorant Garamond', serif";

      setTimeout(function() {
        gate.classList.add('unlocking');
        setTimeout(function() {
          gate.style.display = 'none';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }, 1400);
      }, 900);
    }, 2800);
  }

  /* ── Access denied feedback ─────────────────────────────── */
  function showDenied() {
    var input  = document.getElementById('gate-password-input');
    var error  = document.getElementById('gate-input-error');
    var status = document.getElementById('gate-status');
    var btn    = document.getElementById('gate-btn');

    status.textContent = 'Incorrect code — please try again';
    status.style.color = '#c8876a';

    if (input) {
      input.classList.add('denied');
      input.value = '';
      setTimeout(function() { input.focus(); }, 50);
    }
    if (error) error.textContent = 'That code is not current';

    setTimeout(function() {
      if (input) input.classList.remove('denied');
      if (error) error.textContent = '';
      status.textContent = 'Enter your access code below';
      status.style.color = '';
      btn.disabled       = false;
    }, 2200);
  }

  /* ── Main entry point (called by button onclick) ─────────── */
  window.crackTheVault = function() {
    var input   = document.getElementById('gate-password-input');
    var entered = input ? input.value.trim() : '';
    var btn     = document.getElementById('gate-btn');

    if (!entered) {
      if (input) { input.focus(); }
      return;
    }

    btn.disabled = true;
    try { localStorage.setItem(AUTH_KEY, '1'); } catch(e) {}
    playUnlockAnimation();
  };

  /* ── Enter key support ───────────────────────────────────── */
  document.addEventListener('DOMContentLoaded', function() {
    var input = document.getElementById('gate-password-input');
    if (input) {
      input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') window.crackTheVault();
      });
      /* Auto-focus the input if gate is visible */
      try {
        if (localStorage.getItem(AUTH_KEY) !== '1') {
          setTimeout(function() { input.focus(); }, 600);
        }
      } catch(e) {}
    }
  });
})();
</script>
{%- endif -%}


<!-- ============================================================
     SHARED ENTRY PANEL STYLES
     Club hub: premium botanical / editorial  |  WRC hub: tech grid
============================================================ -->
{%- if is_hub -%}
<style>
/* ── Shared structural base ── */
.club-hub  { background: #080808; }
.wrc-hub   { background: var(--clr-black); }

/* ═══════════════════════════════════════════════════════════
   CLUB HUB — premium editorial panels
═══════════════════════════════════════════════════════════ */
.club-entries {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  background: rgba(184, 168, 130, 0.12);
}

.club-entry {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  position: relative;
  overflow: hidden;
  background: #080808;
  transition: background 0.4s;
}

.club-entry:hover {
  background: #0c0b09;
}

/* Image zone */
.club-entry__visual {
  position: relative;
  aspect-ratio: 3 / 2;
  overflow: hidden;
  background: #111009;
}

.club-entry__visual img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: brightness(0.78) saturate(0.85);
  transition: transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              filter 0.6s ease;
}

.club-entry:hover .club-entry__visual img {
  transform: scale(1.04);
  filter: brightness(0.88) saturate(1);
}

.club-entry__no-img {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #0e0d0a 0%, #080808 100%);
}

/* Gradient scrim */
.club-entry__overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(8,8,8,0.75) 0%, rgba(8,8,8,0.1) 60%, transparent 100%);
}

/* Body */
.club-entry__body {
  padding: 32px 36px 40px;
  display: flex;
  flex-direction: column;
  gap: 0;
  flex: 1;
  border-top: 1px solid rgba(184, 168, 130, 0.12);
  transition: border-color 0.4s;
}

.club-entry:hover .club-entry__body {
  border-top-color: rgba(184, 168, 130, 0.25);
}

.club-entry__eyebrow {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.5rem;
  font-weight: 500;
  color: #A89F8C;
  letter-spacing: 0.38em;
  text-transform: uppercase;
  margin: 0 0 16px;
  opacity: 0.8;
}

.club-entry__title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  font-weight: 300;
  color: #EDE8DC;
  line-height: 1.1;
  letter-spacing: 0.01em;
  margin: 0 0 18px;
  transition: color 0.3s;
}

.club-entry:hover .club-entry__title {
  color: #f5f0e8;
}

.club-entry__title em {
  font-style: italic;
}

.club-entry__desc {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.62rem;
  font-weight: 300;
  color: #A89F8C;
  letter-spacing: 0.04em;
  line-height: 1.9;
  margin: 0 0 28px;
}

.club-entry__foot {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-top: auto;
}

.club-entry__cta {
  font-family: 'Montserrat', sans-serif;
  font-size: 0.5rem;
  font-weight: 500;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: #B8A882;
  display: flex;
  align-items: center;
  gap: 10px;
  transition: color 0.3s, gap 0.3s;
  border-bottom: 1px solid rgba(184, 168, 130, 0.25);
  padding-bottom: 3px;
}

.club-entry:hover .club-entry__cta {
  color: #EDE8DC;
  gap: 16px;
  border-bottom-color: rgba(237, 232, 220, 0.4);
}

/* Warm amber accent — the Club's Core lead panel and the WRC Signature panel
   share this treatment but nothing else; the layout rules below are keyed to
   --core alone so the two can never drag each other around again. */
.club-entry--core .club-entry__eyebrow,
.club-entry--drops .club-entry__eyebrow { color: #C4A45E; }
.club-entry--core .club-entry__cta,
.club-entry--drops .club-entry__cta     { color: #C4A45E; border-bottom-color: rgba(196, 164, 94, 0.25); }
.club-entry--core:hover .club-entry__cta,
.club-entry--drops:hover .club-entry__cta {
  color: #EDE8DC;
  border-bottom-color: rgba(237, 232, 220, 0.4);
}

/* ── Tiered hub: The Core leads, the three sub-ranges sit beneath ── */
.club-entries--tiered {
  grid-template-columns: repeat(3, 1fr);
}

/* Spans the row and paints it, so the space either side of the half-width
   lead is black rather than the container's hairline tint. */
.club-entries--tiered .club-lead {
  grid-column: 1 / -1;
  background: #080808;
  display: flex;
  justify-content: center;
}

/* The lead runs image-beside-text rather than image-above-text, and takes half
   the row so it doesn't stretch across the whole screen. It stays wider than
   its siblings — that's what marks it as the lead — but the type and padding
   are scaled to the narrower card: at full size the title and side padding
   left barely 200px of text column and wrapped badly.
   Below 769px the grid is one column, where the stacked base layout is
   already right — so this stays out of the way there. */
@media (min-width: 769px) {
  .club-entries--tiered .club-entry--core {
    width: 50%;
    flex-direction: row;
    align-items: stretch;
  }

  .club-entries--tiered .club-entry--core .club-entry__visual {
    flex: 1 1 52%;
    aspect-ratio: auto;
    min-height: 280px;
  }

  .club-entries--tiered .club-entry--core .club-entry__body {
    flex: 1 1 48%;
    justify-content: center;
    padding: 36px 40px;
    border-top: none;
    border-left: 1px solid rgba(184, 168, 130, 0.12);
  }

  .club-entries--tiered .club-entry--core:hover .club-entry__body {
    border-left-color: rgba(184, 168, 130, 0.25);
  }

  /* Stay above the siblings, which sit pinned at their 2.8rem (44.8px) cap
     across every desktop width — a lead with smaller type than the tiles
     beneath it reads as the wrong way round. */
  .club-entries--tiered .club-entry--core .club-entry__title {
    font-size: clamp(2.9rem, 3.4vw, 3.2rem);
  }

  .club-entries--tiered .club-entry--core .club-entry__desc {
    font-size: 0.68rem;
  }

  .club-entries--tiered .club-entry--core .club-entry__foot {
    margin-top: 8px;
  }

  /* The scrim is built to fade upward from the bottom of a stacked card.
     Alongside text it reads better raking in from the trailing edge. */
  .club-entries--tiered .club-entry--core .club-entry__overlay {
    background: linear-gradient(to right, rgba(8,8,8,0.55) 0%, rgba(8,8,8,0.12) 45%, rgba(8,8,8,0.5) 100%);
  }
}

/* ═══════════════════════════════════════════════════════════
   WRC HUB — tech grid (unchanged aesthetic)
═══════════════════════════════════════════════════════════ */
.wrc-entries {
  grid-template-columns: repeat(4, 1fr);
  gap: 3px;
  background: transparent;
}

.wrc-entries .club-entry {
  background: var(--clr-panel);
  border: 1px solid var(--clr-border);
  transition: border-color 0.35s, box-shadow 0.35s, transform 0.35s;
}

.wrc-entries .club-entry:hover {
  background: var(--clr-panel);
  border-color: var(--clr-silver-dim);
  transform: translateY(-3px);
  box-shadow: 0 12px 48px rgba(0,0,0,0.6);
}

.wrc-entries .club-entry__visual {
  aspect-ratio: 4 / 3;
}

.wrc-entries .club-entry__visual img {
  filter: grayscale(20%) brightness(0.8);
}

.wrc-entries .club-entry:hover .club-entry__visual img {
  transform: scale(1.05);
  filter: grayscale(0%) brightness(0.95);
}

.wrc-entries .club-entry__body {
  background: var(--clr-panel);
  border-top-color: var(--clr-border);
  padding: 16px 18px 20px;
  gap: 10px;
}

.wrc-entries .club-entry__eyebrow {
  font-family: var(--font-label);
  font-size: 0.5rem;
  color: var(--clr-silver-dim);
  letter-spacing: 0.25em;
  margin-bottom: 6px;
}

.wrc-entries .club-entry__title {
  font-family: var(--font-display);
  font-size: clamp(0.9rem, 1.8vw, 1.25rem);
  font-weight: 700;
  color: var(--clr-white);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin: 0 0 6px;
}

.wrc-entries .club-entry:hover .club-entry__title { color: var(--clr-accent); }

.wrc-entries .club-entry__desc {
  font-family: var(--font-label);
  font-size: 0.58rem;
  color: var(--clr-silver-dim);
  letter-spacing: 0.04em;
  line-height: 1.7;
}

.wrc-entries .club-entry__cta {
  font-family: var(--font-label);
  font-size: 0.55rem;
  font-weight: 700;
  color: var(--clr-silver);
  border-bottom: none;
  padding-bottom: 0;
  letter-spacing: 0.18em;
}

.wrc-entries .club-entry:hover .club-entry__cta { color: var(--clr-accent); gap: 12px; }

/* WRC bracket corners */
.club-entry__bracket {
  position: absolute;
  width: 20px; height: 20px;
  border-color: rgba(200,205,212,0.35);
  border-style: solid;
  z-index: 2;
  transition: border-color 0.3s;
}
.club-entry__bracket--tl { top: 10px; left: 10px; border-width: 1px 0 0 1px; }
.club-entry__bracket--br { bottom: 10px; right: 10px; border-width: 0 1px 1px 0; }
.wrc-entries .club-entry:hover .club-entry__bracket { border-color: rgba(var(--clr-accent-rgb), 0.5); }

/* WRC count badge */
.club-entry__count-badge {
  position: absolute;
  top: 10px; left: 10px;
  z-index: 3;
  background: rgba(0,0,0,0.85);
  border: 1px solid var(--clr-border);
  color: var(--clr-silver-dim);
  font-family: var(--font-display);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 3px 8px;
  letter-spacing: 0.05em;
  display: flex; align-items: baseline; gap: 4px;
}
.club-entry__count-badge span { font-size: 0.42rem; letter-spacing: 0.18em; }

/* WRC top-line sweep */
.wrc-entries .club-entry::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, var(--clr-accent), transparent);
  transform: scaleX(0); transition: transform 0.4s ease; z-index: 4;
}
.wrc-entries .club-entry:hover::before { transform: scaleX(1); }

/* ── Mobile ── */
@media (max-width: 900px) {
  .wrc-entries { grid-template-columns: 1fr 1fr !important; }
}

@media (max-width: 768px) {
  /* Club: single column */
  .club-entries:not(.wrc-entries) {
    grid-template-columns: 1fr;
    background: transparent;
    gap: 1px;
  }

  .club-entry__body { padding: 24px 24px 32px; }
  .club-entry__title { font-size: 2rem; }
  .club-entry__visual { aspect-ratio: 16 / 9; }

  /* The tiered lead panel is already full-width once the grid is one column,
     so drop it back to the same proportions as its siblings. These need the
     same specificity as the desktop --tiered rules to win. */
  /* One column here, so the lead is full width like everything else — the
     wrapper stops being a centring row and the 50% width has to come off. */
  .club-entries--tiered .club-lead { display: block; }
  .club-entries--tiered .club-entry--core { width: 100%; }
  .club-entries--tiered .club-entry--core .club-entry__visual { aspect-ratio: 16 / 9; }
  .club-entries--tiered .club-entry--core .club-entry__body { padding: 24px 24px 32px; }
  .club-entries--tiered .club-entry--core .club-entry__title { font-size: 2.2rem; }
  .club-entries--tiered .club-entry--core .club-entry__desc { font-size: 0.62rem; max-width: none; }

  /* WRC: 2-col compact */
  .wrc-entries .club-entry__visual { aspect-ratio: 1 / 1; }
  .wrc-entries .club-entry__body { padding: 10px 12px 12px; gap: 6px; }
  .wrc-entries .club-entry__desc { display: none; }
  .wrc-entries .club-entry__title { font-size: clamp(0.72rem, 3.2vw, 1rem); margin-bottom: 0; }
  .wrc-entries .club-entry__eyebrow { font-size: 0.42rem; margin-bottom: 4px; }
  .wrc-entries .club-entry__cta { font-size: 0.5rem; }
  .wrc-entries .club-entry__count-badge { font-size: 0.62rem; padding: 2px 6px; top: 8px; left: 8px; }
  .wrc-entries .club-entry__bracket { width: 12px; height: 12px; top: 8px; left: 8px; }
}
</style>
{%- endif -%}

