{% layout 'theme' %}

{%- comment -%}
  Games hub. Assigned to a page via the "games" template suffix; the page's
  own content is ignored. Each tile is one game. A tile with no URL shows
  as "Coming soon" and isn't a link — set terp_wars_url once it's live.
{%- endcomment -%}

{%- assign grow_empire_url = 'https://grow.thewildvault.xyz' -%}
{%- assign terp_wars_url = 'https://terp-wars.netlify.app' -%}

<div class="section games">
  <div class="page-width">

    <div class="section-header">
      <p class="section-eyebrow">Play</p>
      <h1 class="section-title">GAMES</h1>
    </div>

    <div class="games__grid">

      <a href="{{ grow_empire_url }}" class="games__tile" target="_blank" rel="noopener">
        <div class="games__img">
          <img src="{{ 'grow-empire-shot-1.jpg' | asset_url }}" alt="Grow Empire gameplay" loading="eager">
        </div>
        <div class="games__body">
          <h2 class="games__title">Grow Empire</h2>
          <span class="games__cta">Play now &rarr;</span>
        </div>
      </a>

      {%- if terp_wars_url != blank -%}
        <a href="{{ terp_wars_url }}" class="games__tile" target="_blank" rel="noopener">
      {%- else -%}
        <div class="games__tile games__tile--soon" aria-disabled="true">
      {%- endif -%}
          <div class="games__img">
            <img src="{{ 'terp-wars-tile.jpg' | file_url }}" alt="Terp Wars gameplay: Wild Roo facing the Tent King" loading="lazy" width="1200" height="900">
          </div>
          <div class="games__body">
            <h2 class="games__title">Terp Wars</h2>
            <span class="games__cta">{% if terp_wars_url != blank %}Play now &rarr;{% else %}Coming soon{% endif %}</span>
          </div>
      {%- if terp_wars_url != blank -%}
        </a>
      {%- else -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<style>
  .games__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .games__tile { display: block; color: inherit; }
  .games__img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--clr-panel);
  }
  .games__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .games__tile:hover .games__img img { transform: scale(1.04); }
  .games__img--blank { display: grid; place-items: center; border: 1px solid var(--clr-border); }
  .games__wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.4rem, 5vw, 2.6rem);
    letter-spacing: 0.04em;
    color: var(--clr-silver-dim);
  }
  .games__body { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 14px 2px 0; }
  .games__title {
    font-family: var(--font-label);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--clr-white);
  }
  .games__cta {
    font-family: var(--font-label);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--clr-silver);
    white-space: nowrap;
  }
  .games__tile--soon { cursor: default; }
  .games__tile--soon .games__cta { color: var(--clr-silver-dim); }
  @media (max-width: 600px) {
    .games__grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
