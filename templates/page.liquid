{% layout 'theme' %}

<div class="section">
  <div class="page-width" style="max-width:860px;">

    <!-- Header -->
    <div style="margin-bottom:48px;padding-bottom:32px;border-bottom:1px solid var(--clr-border);">
      <h1 class="section-title" style="text-align:left;">{{ page.title }}</h1>
    </div>

    <!-- Content -->
    <div class="page-content rte">
      {{ page.content }}
    </div>

  </div>
</div>

<style>
  /* Long-form reading copy — body font, full size, no tracking */
  .rte {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--clr-silver);
    line-height: 1.75;
    letter-spacing: 0;
  }
  .rte h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 800;
    color: var(--clr-white);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 44px 0 14px;
  }
  .rte h3, .rte h4 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--clr-white);
    text-transform: uppercase;
    letter-spacing: 0;
    margin: 30px 0 10px;
  }
  .rte p { margin-bottom: 18px; }
  .rte > p:first-of-type {
    font-size: 1.2rem;
    color: var(--clr-white);
    line-height: 1.6;
  }
  .rte a { color: var(--clr-accent); text-decoration: underline; text-decoration-color: rgba(var(--clr-accent-rgb), 0.3); }
  .rte a:hover { text-decoration-color: var(--clr-accent); }
  .rte ul, .rte ol { padding-left: 24px; margin-bottom: 16px; }
  .rte li { margin-bottom: 8px; }
  .rte blockquote {
    border-left: 2px solid var(--clr-accent);
    padding-left: 20px;
    color: var(--clr-silver);
    font-style: italic;
    margin: 24px 0;
  }
  .rte strong { color: var(--clr-silver); }
  .rte code {
    background: var(--clr-panel);
    border: 1px solid var(--clr-border);
    padding: 2px 6px;
    border-radius: 3px;
    color: var(--clr-accent);
    font-size: 0.75rem;
  }
  .rte img {
    max-width: 100%;
    border: 1px solid var(--clr-border);
  }
  .rte hr {
    border: none;
    border-top: 1px solid var(--clr-border);
    margin: 32px 0;
  }
</style>
