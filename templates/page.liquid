{% layout 'theme' %}

<div class="section">
  <div class="page-width" style="max-width:860px;">

    <!-- Header -->
    <div style="margin-bottom:48px;padding-bottom:32px;border-bottom:1px solid var(--clr-border);">
      <h1 class="section-title" style="text-align:left;">{{ page.title }}</h1>
    </div>

    <!-- Content -->
    <div class="page-content rte">
      {{ page.content }}
    </div>

  </div>
</div>
