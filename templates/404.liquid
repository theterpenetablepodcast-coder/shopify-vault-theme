{% layout 'theme' %}

<div class="section section--lg" style="min-height:70vh;display:flex;align-items:center;justify-content:center;text-align:center;">
  <div data-reveal>

    <div style="width:88px;height:88px;margin:0 auto 32px;opacity:0.5;">
      {%- render 'wrc-mark' -%}
    </div>

    <p class="section-eyebrow" style="justify-content:center;">Error 404</p>

    <h1 style="font-family:var(--font-display);font-size:clamp(2.6rem,9vw,5.5rem);font-weight:900;color:var(--clr-white);letter-spacing:-0.035em;line-height:0.95;margin-bottom:20px;text-transform:uppercase;">
      Page not found
    </h1>

    <p style="font-family:var(--font-body);font-size:1.05rem;color:var(--clr-silver);margin:0 auto 36px;max-width:460px;line-height:1.7;">
      We can't find the page you were after. It may have moved, or the link might be out of date.
    </p>

    <!-- Inline search -->
    <form action="{{ routes.search_url }}" method="get" style="max-width:480px;margin:0 auto 32px;">
      <input type="hidden" name="type" value="product">
      <div style="display:flex;border:1px solid var(--clr-border);border-radius:var(--radius);overflow:hidden;">
        <input type="search"
               name="q"
               placeholder="Search the store..."
               style="flex:1;background:var(--clr-panel);border:none;color:var(--clr-white);font-family:var(--font-body);font-size:0.95rem;padding:14px 18px;outline:none;"
               aria-label="Search products">
        <button type="submit"
                style="background:var(--clr-green);border:none;color:var(--clr-black);font-family:var(--font-label);font-size:0.75rem;letter-spacing:0.14em;font-weight:600;padding:0 22px;text-transform:uppercase;cursor:pointer;">
          Search
        </button>
      </div>
    </form>

    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      <a href="{{ routes.root_url }}" class="btn btn--primary">BACK TO HOME</a>
      <a href="/collections/merch" class="btn btn--outline">SHOP THE RANGE</a>
    </div>

  </div>
</div>
