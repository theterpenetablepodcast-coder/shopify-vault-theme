{% layout 'theme' %}

{%- comment -%}
  Work out once which collections this index should show, so the count in
  the hero and the cards below can never disagree.

  Hidden here:
    • retired  — emptied but kept in admin (see templates/collection.liquid)
    • ranges   — WRC and Club sub-ranges, reached via their own hub pages
    • empty    — anything with no products. Belt and braces: a collection
                 that gets emptied later stops advertising itself without
                 anyone having to remember to add it to a list.

  The Cultivators Club is counted as visible but rendered separately as the
  featured card below, so it's excluded from the top row only.
{%- endcomment -%}
{%- assign retired_handles = 'genetics,secured,frontpage' | split: ',' -%}
{%- assign range_handles = 'the-uniform,the-drops,club-accessories,the-roots,the-movement,the-wrc-signature,the-kit-and-carry' | split: ',' -%}

{%- capture visible_handles -%}
  {%- for collection in collections -%}
    {%- assign hide = false -%}
    {%- if retired_handles contains collection.handle -%}{%- assign hide = true -%}{%- endif -%}
    {%- if range_handles contains collection.handle -%}{%- assign hide = true -%}{%- endif -%}
    {%- if collection.products_count == 0 -%}{%- assign hide = true -%}{%- endif -%}
    {%- unless hide -%}{{ collection.handle }},{%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign visible_list = visible_handles | strip | split: ',' -%}

{% paginate collections by 18 %}

<!-- ── Page hero ── -->
<div style="background:var(--clr-black);border-bottom:1px solid var(--clr-border);padding:72px 0 60px;position:relative;overflow:hidden;">

  <!-- radial glow -->
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 60% 50% at 50% 100%,rgba(var(--clr-accent-rgb), 0.07),transparent);" aria-hidden="true"></div>

  <div class="page-width" style="position:relative;z-index:1;text-align:center;">
    <p class="section-eyebrow">INVENTORY</p>
    <h1 class="section-title" data-scramble-scroll>THE RANGE</h1>
    <p class="section-desc">Everything we make, in one place.</p>

    <!-- live count -->
    <div style="margin-top:28px;display:inline-flex;align-items:center;gap:12px;background:rgba(var(--clr-accent-rgb), 0.06);border:1px solid rgba(var(--clr-accent-rgb), 0.2);padding:9px 20px;border-radius:999px;">
      <span style="width:6px;height:6px;background:var(--clr-accent);border-radius:50%;box-shadow:var(--glow-accent);display:block;animation:ringPulse 2s ease-in-out infinite;" aria-hidden="true"></span>
      <span style="font-family:var(--font-label);font-size:0.65rem;color:var(--clr-accent);letter-spacing:0.14em;text-transform:uppercase;">
        {{ visible_list.size }} {% if visible_list.size == 1 %}CATEGORY{% else %}CATEGORIES{% endif %}
      </span>
    </div>
  </div>
</div>

<!-- ── Collections grid ── -->
<section class="section">
  <div class="page-width">

    {%- comment -%} Separate the featured Cultivators Club from the rest {%- endcomment -%}
    {%- comment -%} ── Row 1: standard cards (centred 2-up) ── {%- endcomment -%}
    <div class="collections-top-row">
      {%- for collection in collections -%}
        {%- comment -%} Club is visible but renders as the featured card below {%- endcomment -%}
        {%- assign in_top_row = false -%}
        {%- if visible_list contains collection.handle -%}
          {%- unless collection.handle contains 'cultivator' -%}
            {%- assign in_top_row = true -%}
          {%- endunless -%}
        {%- endif -%}
        {%- if in_top_row -%}
          {%- assign custom_banner = '' -%}
          {%- if collection.handle contains 'cloth' or collection.handle contains 'merch' -%}
            {%- assign custom_banner = 'collection-clothing.png' | asset_url -%}
          {%- endif -%}
          <a href="{{ collection.url }}" class="collection-card" aria-label="{{ collection.title }}">

            <!-- Image -->
            <div class="collection-card__img">
              {%- if custom_banner != '' -%}
                <img src="{{ custom_banner }}"
                     alt="{{ collection.title | escape }}"
                     width="800" height="600"
                     loading="lazy">
              {%- elsif collection.image -%}
                <img src="{{ collection.image | img_url: '800x600', crop: 'center' }}"
                     alt="{{ collection.image.alt | default: collection.title | escape }}"
                     width="800" height="600"
                     loading="lazy">
              {%- elsif collection.products.first.featured_image -%}
                <img src="{{ collection.products.first.featured_image | img_url: '800x600', crop: 'center' }}"
                     alt="{{ collection.title | escape }}"
                     width="800" height="600"
                     loading="lazy">
              {%- else -%}
                <!-- No image fallback -->
                <div class="collection-card__no-img" aria-hidden="true">
                  {% render 'wrc-mark', size: 76 %}
                </div>
              {%- endif -%}

              <!-- Overlay on hover -->
              <div class="collection-card__overlay">
                <span class="collection-card__cta">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  SHOP NOW
                </span>
              </div>

              <!-- Product count badge -->
              <div class="collection-card__count">
                {{ collection.products_count }}
                <span style="font-size:0.5rem;letter-spacing:0.15em;margin-left:2px;">ITEMS</span>
              </div>
            </div>

            <!-- Body -->
            <div class="collection-card__body">
              <div>
                <p class="collection-card__eyebrow">Shop</p>
                <h2 class="collection-card__title">{{ collection.title }}</h2>
                {%- if collection.description != blank -%}
                  <p class="collection-card__desc">{{ collection.description | strip_html | truncate: 80 }}</p>
                {%- endif -%}
              </div>
              <div class="collection-card__arrow" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </div>
            </div>

          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} ── Row 2: Cultivators Club — full-width featured card ── {%- endcomment -%}
    {%- for collection in collections -%}
      {%- if collection.handle contains 'cultivator' -%}
        <a href="{{ collection.url }}" class="collection-card collection-card--featured" aria-label="{{ collection.title }}">

          <div class="collection-card__img">
            {%- comment -%} Use static asset so the banner text is always correct {%- endcomment -%}
            <img src="{{ 'collection-the-cultivators-club.png' | asset_url }}"
                 alt="{{ collection.title | escape }}"
                 width="3200" height="800"
                 loading="lazy"
                 style="object-fit:cover;width:100%;height:100%;">

            <!-- Limited drops badge -->
            <div class="collection-card__limited" aria-label="Limited drops">
              <span style="width:6px;height:6px;background:var(--clr-accent);border-radius:50%;box-shadow:var(--glow-accent);animation:ringPulse 1.5s ease-in-out infinite;flex-shrink:0;"></span>
              LIMITED DROPS
            </div>

            <!-- Product count -->
            <div class="collection-card__count">
              {{ collection.products_count }}
              <span style="font-size:0.5rem;letter-spacing:0.15em;margin-left:2px;">ITEMS</span>
            </div>

            <!-- Hover overlay -->
            <div class="collection-card__overlay">
              <span class="collection-card__cta">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                ENTER THE CLUB
              </span>
            </div>
          </div>

          <div class="collection-card__body collection-card__body--featured">
            <div>
              <p class="collection-card__eyebrow">Members only</p>
              <h2 class="collection-card__title collection-card__title--featured">{{ collection.title }}</h2>
              {%- if collection.description != blank -%}
                {%- comment -%}
                  Close the paragraphs before stripping. strip_html joins
                  block tags with nothing between them, so a multi-paragraph
                  description would otherwise read "…clubhouse.The Cultivators…".
                {%- endcomment -%}
                <p class="collection-card__desc" style="max-width:600px;">{{ collection.description | replace: '</p>', '</p> ' | replace: '<br>', ' ' | strip_html | strip | truncate: 140 }}</p>
              {%- else -%}
                <p class="collection-card__desc" style="max-width:600px;">The premium line. Strictly limited runs for members only.</p>
              {%- endif -%}
            </div>
            <div class="collection-card__arrow" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </div>
          </div>

        </a>
      {%- endif -%}
    {%- endfor -%}

    <!-- Pagination -->
    {%- if paginate.pages > 1 -%}
      <nav style="margin-top:60px;display:flex;align-items:center;justify-content:center;gap:8px;" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}" class="btn btn--outline" style="padding:10px 20px;font-size:0.65rem;">← PREV</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="btn btn--outline" style="padding:10px 16px;font-size:0.65rem;">{{ part.title }}</a>
          {%- else -%}
            <span style="font-family:var(--font-label);font-size:0.7rem;color:var(--clr-accent);padding:10px 16px;border:1px solid var(--clr-accent);min-width:40px;text-align:center;">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}" class="btn btn--outline" style="padding:10px 20px;font-size:0.65rem;">NEXT →</a>
        {%- endif -%}
      </nav>
    {%- endif -%}

  </div>
</section>

{% endpaginate %}

{% render 'collection-card-styles' %}
