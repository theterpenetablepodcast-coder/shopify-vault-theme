{% layout 'theme' %}

{%- comment -%}
  Club pieces are kept out of general search (snippets/product-card renders
  nothing for them here), so the count has to leave them out as well —
  searching "tee" said 35 results and showed five.
{%- endcomment -%}
{%- capture club_handles -%}{%- render 'club-handles' -%}{%- endcapture -%}
{%- assign club_list = club_handles | strip | split: ',' -%}
{%- assign shown_count = 0 -%}
{%- if search.performed -%}
  {%- for result in search.results -%}
    {%- if result.object_type == 'product' -%}
      {%- assign result_is_club = false -%}
      {%- if result.vendor contains 'Cultivat' -%}{%- assign result_is_club = true -%}{%- endif -%}
      {%- for col in result.collections -%}
        {%- if club_list contains col.handle or col.handle contains 'cultivator' -%}
          {%- assign result_is_club = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless result_is_club -%}{%- assign shown_count = shown_count | plus: 1 -%}{%- endunless -%}
    {%- else -%}
      {%- assign shown_count = shown_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<div class="section">
  <div class="page-width">

    <div class="section-header" data-reveal>
      <h1 class="section-title">SEARCH</h1>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <input type="hidden" name="type" value="product">
      <div class="search-page__field">
        <input type="search"
               name="q"
               value="{{ search.terms | escape }}"
               placeholder="Search products"
               class="search-page__input"
               autocomplete="off"
               aria-label="Search products">
        <button type="submit" class="search-page__submit">Search</button>
      </div>
    </form>

    {%- if search.performed -%}
      <p class="search-page__summary">
        {%- if shown_count > 0 -%}
          <span class="search-page__count">{{ shown_count }}</span> {% if shown_count == 1 %}result{% else %}results{% endif %} for “<span class="search-page__terms">{{ search.terms | escape }}</span>”
        {%- else -%}
          No results for “<span class="search-page__terms">{{ search.terms | escape }}</span>”. Try another word, or <a href="/collections/merch">browse Clothing</a>.
        {%- endif -%}
      </p>

      {%- if shown_count > 0 -%}
        <div class="product-grid">
          {%- for result in search.results -%}
            {%- if result.object_type == 'product' -%}
              {%- render 'product-card', product: result, show_vendor: true -%}
            {%- else -%}
              <article class="vault-card">
                <div class="vault-card__body">
                  <p class="vault-card__category">{{ result.object_type | upcase }}</p>
                  <h3 class="vault-card__title"><a href="{{ result.url }}">{{ result.title }}</a></h3>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    {%- endif -%}

  </div>
</div>
