<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }} — Opening soon</title>
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body style="background:var(--clr-void);min-height:100vh;display:flex;align-items:center;justify-content:center;overflow:hidden;">

  <div id="vault-toast" aria-live="polite"></div>

  <!-- Growth glow -->
  <div aria-hidden="true"
       style="position:fixed;inset:0;background:radial-gradient(ellipse 60% 50% at 50% 110%, rgba(var(--clr-green-rgb), 0.16), transparent 70%);"></div>

  <div style="position:relative;z-index:10;text-align:center;max-width:480px;padding:0 24px;width:100%;">

    <div style="width:96px;height:96px;margin:0 auto 36px;">
      {%- render 'wrc-mark' -%}
    </div>

    <p style="font-family:var(--font-label);font-size:0.7rem;font-weight:600;color:var(--clr-green);letter-spacing:0.26em;text-transform:uppercase;margin-bottom:14px;display:flex;align-items:center;justify-content:center;gap:10px;">
      <span style="display:block;width:28px;height:1px;background:currentColor;opacity:0.45;"></span>
      Opening soon
      <span style="display:block;width:28px;height:1px;background:currentColor;opacity:0.45;"></span>
    </p>

    <h1 style="font-family:var(--font-display);font-size:clamp(2.2rem,7vw,3.6rem);font-weight:900;color:var(--clr-white);letter-spacing:-0.03em;line-height:0.95;text-transform:uppercase;margin-bottom:16px;">
      {{ shop.name }}
    </h1>

    <p style="font-family:var(--font-body);font-size:1rem;color:var(--clr-silver);margin-bottom:36px;line-height:1.7;">
      {{ shop.password_message | default: "We're putting the finishing touches on things. Got a password? Come on in." }}
    </p>

    <!-- Password form -->
    {%- form 'storefront_password' -%}
      <div style="border:1px solid var(--clr-border);border-radius:var(--radius);overflow:hidden;margin-bottom:16px;">
        <input type="password"
               name="password"
               id="Password"
               style="display:block;width:100%;background:var(--clr-panel);border:none;color:var(--clr-white);font-family:var(--font-body);font-size:0.95rem;padding:16px 20px;text-align:center;letter-spacing:0.2em;outline:none;"
               placeholder="Enter password"
               autofocus
               aria-label="Store password">
      </div>

      {%- if form.errors -%}
        <p style="font-family:var(--font-label);font-size:0.75rem;font-weight:500;color:var(--clr-danger);margin-bottom:16px;">
          That password didn't work — have another go.
        </p>
      {%- endif -%}

      <button type="submit"
              class="btn btn--primary"
              style="width:100%;justify-content:center;height:52px;">
        Enter
      </button>
    {%- endform -%}

    <p style="margin-top:36px;font-family:var(--font-label);font-size:0.7rem;font-weight:500;color:var(--clr-silver-dim);letter-spacing:0.2em;text-transform:uppercase;">
      WildRoot Cultivars — Australian Owned
    </p>

  </div>

  {{ content_for_layout }}
  <script src="{{ 'vault.js' | asset_url }}" defer></script>
</body>
</html>
